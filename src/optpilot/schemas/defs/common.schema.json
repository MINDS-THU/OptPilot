{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optpilot.io/schemas/defs/common.schema.json",
  "definitions": {
    "apiVersion": {
      "const": "optpilot.io/v1"
    },
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "pythonImport": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "envObject": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/setupStep"}
        },
        "env": {"$ref": "#/definitions/envObject"},
        "envFromHost": {"$ref": "#/definitions/stringList"},
        "cache": {"enum": ["prepared"]},
        "timeoutSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "setupStep": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["uses"],
          "properties": {
            "uses": {"const": "uv"},
            "cwd": {"type": "string"},
            "env": {"$ref": "#/definitions/envObject"},
            "extras": {"$ref": "#/definitions/stringList"},
            "groups": {"$ref": "#/definitions/stringList"},
            "frozen": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["uses"],
          "properties": {
            "uses": {"const": "python-venv"},
            "cwd": {"type": "string"},
            "env": {"$ref": "#/definitions/envObject"},
            "python": {"type": "string"},
            "venv": {"type": "string"},
            "requirements": {"$ref": "#/definitions/stringList"},
            "installProject": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["uses"],
          "properties": {
            "uses": {"const": "npm"},
            "cwd": {"type": "string"},
            "env": {"$ref": "#/definitions/envObject"},
            "install": {"enum": ["ci", "install"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["uses", "command"],
          "properties": {
            "uses": {"const": "command"},
            "cwd": {"type": "string"},
            "env": {"$ref": "#/definitions/envObject"},
            "command": {"$ref": "#/definitions/command"}
          }
        }
      ]
    },
    "interfaceRuntime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sandbox": {"enum": ["process", "container"]},
        "setup": {"$ref": "#/definitions/interfaceSetup"},
        "container": {"$ref": "#/definitions/interfaceContainer"}
      },
      "allOf": [
        {
          "if": {
            "required": ["sandbox"],
            "properties": {"sandbox": {"const": "container"}}
          },
          "then": {"required": ["container"]},
          "else": {"not": {"required": ["container"]}}
        }
      ]
    },
    "interfaceSetup": {
      "allOf": [
        {"$ref": "#/definitions/setup"},
        {"not": {"required": ["envFromHost"]}}
      ]
    },
    "interfaceContainer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "image": {"type": "string", "minLength": 1, "maxLength": 1024},
        "platform": {"type": "string", "minLength": 1, "maxLength": 256},
        "build": {"$ref": "#/definitions/interfaceContainerBuild"}
      },
      "oneOf": [
        {"required": ["image"], "not": {"required": ["build"]}},
        {"required": ["build"], "not": {"required": ["image"]}}
      ]
    },
    "interfaceContainerBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag"],
      "properties": {
        "tag": {"type": "string", "minLength": 1, "maxLength": 1024},
        "context": {"type": "string", "minLength": 1},
        "dockerfile": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1, "maxLength": 256},
        "args": {"$ref": "#/definitions/envObject"}
      }
    },
    "interfaceGrants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {"enum": ["disabled", "enabled"]},
        "envFromHost": {"$ref": "#/definitions/stringList"},
        "secretsFromHost": {"$ref": "#/definitions/stringList"}
      }
    },
    "interfaceResources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {"type": "integer", "minimum": 1, "maximum": 1024},
        "memoryMiB": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "gpus": {"type": "integer", "minimum": 0, "maximum": 64}
      }
    },
    "interfacePresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "port"],
      "properties": {
        "kind": {"const": "web"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "extraPorts": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 65535}
        },
        "readyPath": {"type": "string", "minLength": 1, "maxLength": 2048},
        "readyTimeoutSeconds": {"type": "integer", "minimum": 0, "maximum": 600}
      }
    },
    "interfaceAccepts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selectionKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["candidate", "trial", "artifact", "workspace"]}
        },
        "mediaTypes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "interfaceOutputAction": {
      "description": "A registered command that OptPilot may run against a sealed tree output in a new isolated instance of the originating interface's prepared runtime. The live interface process and its environment or secret grants are never reused.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "command", "timeoutSeconds"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "command": {"$ref": "#/definitions/command"},
        "cwd": {
          "description": "Portable directory relative to the selected output tree.",
          "type": "string",
          "minLength": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "acceptsArguments": {
          "description": "Whether the user may append bounded argv tokens to this registered command.",
          "type": "boolean"
        },
        "showInOutputCard": {
          "description": "Whether Studio also presents this action on each output card. Set false when the interface already provides the action in its own UI.",
          "type": "boolean"
        },
        "runtime": {
          "description": "Reuse the originating profile's prepared runtime definition in a new isolated execution; never reuse its live process or launch grants.",
          "const": "originating-interface"
        }
      }
    },
    "interfaceOutputs": {
      "oneOf": [
        {
          "const": true
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["actions"],
          "properties": {
            "actions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {"$ref": "#/definitions/interfaceOutputAction"}
            }
          }
        }
      ]
    },
    "interfaceSingleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "presentation"],
      "properties": {
        "label": {"type": "string"},
        "description": {"type": "string"},
        "command": {"$ref": "#/definitions/command"},
        "cwd": {"type": "string"},
        "env": {"$ref": "#/definitions/envObject"},
        "runtime": {"$ref": "#/definitions/interfaceRuntime"},
        "grants": {"$ref": "#/definitions/interfaceGrants"},
        "resources": {"$ref": "#/definitions/interfaceResources"},
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "presentation": {"$ref": "#/definitions/interfacePresentation"},
        "accepts": {"$ref": "#/definitions/interfaceAccepts"},
        "outputs": {
          "description": "Opt in to Studio's launch-scoped output reporting protocol and optionally register commands available for every reported tree output. Actual output ids, labels, kinds, and relative paths remain dynamic.",
          "$ref": "#/definitions/interfaceOutputs"
        }
      }
    },
    "interfaceNamedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "presentation"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": {"type": "string"},
        "description": {"type": "string"},
        "command": {"$ref": "#/definitions/command"},
        "cwd": {"type": "string"},
        "env": {"$ref": "#/definitions/envObject"},
        "runtime": {"$ref": "#/definitions/interfaceRuntime"},
        "grants": {"$ref": "#/definitions/interfaceGrants"},
        "resources": {"$ref": "#/definitions/interfaceResources"},
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "presentation": {"$ref": "#/definitions/interfacePresentation"},
        "accepts": {"$ref": "#/definitions/interfaceAccepts"},
        "outputs": {
          "description": "Opt in to Studio's launch-scoped output reporting protocol and optionally register commands available for every reported tree output. Actual output ids, labels, kinds, and relative paths remain dynamic.",
          "$ref": "#/definitions/interfaceOutputs"
        }
      }
    },
    "interface": {
      "description": "Optional launchable UI shared by Environment, Method, and Resource configs. A producing profile opts into the language-neutral output-reporting protocol with outputs: true or an outputs action allowlist; output instances are then reported by the running interface rather than declared as YAML paths.",
      "oneOf": [
        {"$ref": "#/definitions/interfaceSingleProfile"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["launchProfiles"],
          "properties": {
            "launchProfiles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {"$ref": "#/definitions/interfaceNamedProfile"}
            }
          }
        }
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
