{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optpilot.io/schemas/method.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "config",
    "id",
    "entrypoint",
    "accepts"
  ],
  "properties": {
    "apiVersion": {
      "$ref": "defs/common.schema.json#/definitions/apiVersion"
    },
    "config": {
      "const": "method"
    },
    "id": {
      "$ref": "defs/common.schema.json#/definitions/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "How this is named for a person reading the Catalog. Without it the identifier is shown, which reads as a slug rather than a name."
    },
    "description": {
      "$ref": "defs/common.schema.json#/definitions/description"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "What this is for, as short verb-object slugs such as optimize-policy or solve-or-problem. Searching expands ordinary words to these, so a person who types \"optimize\" finds work that does it."
    },
    "tags": {
      "$ref": "defs/common.schema.json#/definitions/tags"
    },
    "interface": {
      "$ref": "defs/common.schema.json#/definitions/interface"
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "python": {
          "$ref": "defs/common.schema.json#/definitions/pythonImport"
        },
        "pythonPath": {
          "$ref": "defs/common.schema.json#/definitions/stringList"
        },
        "command": {
          "$ref": "defs/common.schema.json#/definitions/command"
        },
        "protocol": {
          "enum": [
            "batch",
            "session"
          ],
          "description": "Exchange protocol. Use 'batch'. 'session' is reserved and EXPERIMENTAL: it validates but the retained runner does not execute it, so a session study fails during retained compilation. See methods.md."
        },
        "exchangeTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "oneOf": [
        {
          "required": [
            "python"
          ]
        },
        {
          "required": [
            "command"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "protocol": {
                "enum": [
                  "batch"
                ]
              }
            }
          }
        }
      ]
    },
    "settings": {
      "type": "object"
    },
    "settingsSchema": {
      "$ref": "defs/candidate.schema.json#/definitions/parameterMap"
    },
    "accepts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats"
      ],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "parameters",
              "files",
              "opaque"
            ]
          }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "context": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "runtime": {
      "$ref": "defs/runtime.schema.json#/definitions/methodRuntime"
    }
  }
}
