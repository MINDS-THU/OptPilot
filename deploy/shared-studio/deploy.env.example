# Copy to deploy.env, use absolute paths, and keep that file mode 600.
OPTPILOT_STATE_ROOT="/absolute/path/to/optpilot-shared-state"
# Keep credentials, TLS keys, Catalog templates, runtime ownership records,
# and gateway configuration outside the mountable Studio working tree.
OPTPILOT_PRIVATE_ROOT="/absolute/path/to/optpilot-shared-private"
OPTPILOT_CATALOG_ROOT="/absolute/path/to/optpilot-shared-private/catalog"
# Keep this deployment separate from packages and outputs published by older
# local OptPilot checkouts.
OPTPILOT_REALM_ROOT="/absolute/path/to/optpilot-shared-private/realm"
OPTPILOT_LOCAL_PACKAGE_NAME="devs_generator_v2"
# Space-separated source packages to omit from this deployment. The current
# DEVS generator is installed above, so hiding the older gallery copy avoids
# presenting two generators with nearly identical names.
OPTPILOT_SOURCE_CATALOG_EXCLUDES="devs_gallery"

PUBLIC_HOST="studio.example.edu"
# One specific address assigned to the host. Never use 0.0.0.0, and do not use
# 127.0.0.1 because the private backends own the same dynamic port numbers.
PUBLIC_BIND_IP="replace-with-host-interface-ip"
PUBLIC_SERVER_NAME="studio.example.edu"
STUDIO_PORT="28666"

TLS_CERTIFICATE="/absolute/path/to/fullchain.pem"
TLS_CERTIFICATE_KEY="/absolute/path/to/privkey.pem"
# Use dns-duckdns when public TCP 80 is unavailable. Keep this token file
# outside the repository and all mountable Workspace roots, with mode 600.
CERTBOT_CHALLENGE_MODE="http"
DUCKDNS_TOKEN_FILE="/absolute/path/to/duckdns-token"
DUCKDNS_PROPAGATION_SECONDS="60"
CERTIFICATE_AUTO_RENEW_ENABLED="0"
CERTIFICATE_RENEW_HOUR="3"
CERTIFICATE_RENEW_MINUTE="17"
# Space-separated trusted source networks. Confirm the current campus ranges
# with the network operator before a public launch.
ALLOWED_CIDRS="166.111.0.0/16 59.66.0.0/16 101.5.0.0/16 101.6.0.0/16"

WORKSPACE_RUNTIME_BIN="docker"
WORKSPACE_RUNTIME_IMAGE="optpilot/workspace-dev:latest"
WORKSPACE_RUNTIME_NETWORK="bridge"
WORKSPACE_RUNTIME_PORT_START="28766"
WORKSPACE_RUNTIME_PORT_COUNT="110"
PREVIEW_PORT_OFFSET="1000"

SHARED_AUTH_CREDENTIALS_FILE="/absolute/path/to/shared-login-credentials.json"
SHARED_AUTH_SESSION_DB="/absolute/path/to/optpilot-shared-private/shared-auth-sessions.sqlite3"
SHARED_AUTH_SESSION_TTL_SECONDS="43200"

OPTPILOT_OPENHANDS_ENABLED="1"
OPENHANDS_HOST="127.0.0.1"
OPENHANDS_PORT="28681"
OPENHANDS_AGENT_SERVER_BIN="/absolute/path/to/agent-server"
OPTPILOT_OPENHANDS_SESSION_ENDPOINT="/api/conversations"
OPTPILOT_OPENHANDS_MODEL="openrouter/deepseek/deepseek-v4-pro"
OH_SECRET_KEY="replace-with-a-long-random-secret"

OPENROUTER_API_KEY="replace-with-a-new-openrouter-key"
DEVS_INTERFACE_MODEL_ID="openrouter/deepseek/deepseek-v4-flash"
DEVS_INTERFACE_STRONG_MODEL_ID="openrouter/deepseek/deepseek-v4-flash"
DEVS_DISPLAY_MODEL_ID="openrouter/deepseek/deepseek-v4-flash"
# The interface runs inside Docker; the collector itself remains host-loopback.
DEVS_COLLECTOR_URL="http://host.docker.internal:8010"
DEVS_COLLECTOR_HEALTHCHECK_URL="http://127.0.0.1:8010/health"
DEVS_COLLECTOR_INGEST_TOKEN="replace-with-the-current-collector-token"

NGINX_BIN="/opt/homebrew/opt/nginx/bin/nginx"
# First launch indexes the catalogs and can take about a minute on macOS.
START_TIMEOUT_SECONDS="180"
