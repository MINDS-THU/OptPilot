# Copy to deploy.env, fill the required values, and set mode 600.

# Required paths. Catalog, Realm, TLS, login database, logs, and gateway paths
# are derived below OPTPILOT_PRIVATE_ROOT.
OPTPILOT_STATE_ROOT="/absolute/path/to/optpilot-shared-state"
OPTPILOT_PRIVATE_ROOT="/absolute/path/to/optpilot-shared-private"

# Required public boundary. Bind one real host address, never 0.0.0.0 or the
# 127.0.0.1 address reserved for private backends.
PUBLIC_HOST="studio.example.edu"
PUBLIC_BIND_IP="replace-with-host-interface-ip"
# Confirm the real campus ranges with the network operator. This documentation
# range deliberately fails closed until replaced.
ALLOWED_CIDRS="192.0.2.0/24"

# Required application credentials. Keep deploy.env outside every Workspace
# root and readable only by the deployment account.
OPTPILOT_ADMIN_PASSWORD="replace-with-a-long-random-admin-password"
OH_SECRET_KEY="replace-with-a-long-random-openhands-secret"
OPENROUTER_API_KEY="replace-with-a-new-openrouter-key"

# Registration is closed by default. Generate a code with:
# bash deploy/shared-studio/deploy.sh generate-invitation
OPTPILOT_REGISTRATION_ENABLED="0"
OPTPILOT_INVITATION_CODE=""

# Certificate files default to:
#   $OPTPILOT_PRIVATE_ROOT/tls/fullchain.pem
#   $OPTPILOT_PRIVATE_ROOT/tls/privkey.pem
# For DuckDNS DNS-01, keep the token at the derived path below, mode 600.
CERTBOT_CHALLENGE_MODE="http"
# DUCKDNS_TOKEN_FILE="$OPTPILOT_PRIVATE_ROOT/credentials/duckdns-token"
# CERTIFICATE_AUTO_RENEW_ENABLED="1"

# Optional durable DEVS collection. Set all four or leave all four empty.
# DEVS_COLLECTOR_URL="http://host.docker.internal:8010"
# DEVS_HEADLESS_COLLECTOR_URL="http://127.0.0.1:8010"
# DEVS_COLLECTOR_HEALTHCHECK_URL="http://127.0.0.1:8010/health"
# DEVS_COLLECTOR_INGEST_TOKEN="replace-with-collector-ingest-token"

# Optional overrides. The defaults are the tested shared deployment profile.
# STUDIO_PORT="28666"
# WORKSPACE_RUNTIME_PORT_START="28766"
# WORKSPACE_RUNTIME_PORT_COUNT="110"
# WORKSPACE_RUNTIME_IDLE_TIMEOUT_SECONDS="3600"
# WORKSPACE_RUNTIME_MAX_ACTIVE_PER_ACCOUNT="3"
# INTERFACE_MAX_ACTIVE_PER_ACCOUNT="1"
# CLASSROOM_AUTH_SESSION_TTL_SECONDS="604800"
# CLASSROOM_AUTH_MAX_ACCOUNTS="100"
# OPTPILOT_SOURCE_CATALOG_EXCLUDES="devs_gallery"
# OPTPILOT_OPENHANDS_MODEL="openrouter/deepseek/deepseek-v4-pro"
# DEVS_INTERFACE_MODEL_ID="openrouter/deepseek/deepseek-v4-flash"
# DEVS_INTERFACE_STRONG_MODEL_ID="openrouter/deepseek/deepseek-v4-flash"
# DEVS_DISPLAY_MODEL_ID="openrouter/deepseek/deepseek-v4-flash"
# OPENHANDS_AGENT_SERVER_BIN="$HOME/.local/share/optpilot/openhands-venv-1.40.1/bin/agent-server"
# NGINX_BIN="/opt/homebrew/opt/nginx/bin/nginx"
# START_TIMEOUT_SECONDS="180"

# Compatibility identity for existing shared deployments. New deployments can
# omit it; changing it later creates a distinct Catalog source.
# OPTPILOT_LOCAL_PACKAGE_NAME="devs_generator_v2"
